---
import MaskedTitle from '../components/MaskedTitle.astro';
import { withBase } from '../consts';
import Base from '../layouts/Base.astro';
import { getSeries, tracks } from '../series';

const { series, loose } = await getSeries();
const published = series.filter((s) => s.post);
const first = published[0] ?? loose[0];
const inTrack = (id: string) => series.filter((s) => s.track?.id === id);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const href = (slug: string) => withBase(`/posts/${slug}/`);
---

<Base>
	<main class="home">
		<section class="hero">
			<p class="kicker">Learning notes · diffusion language models</p>
			<MaskedTitle tokens={['Diffusion', ' LLMs', ',', ' un', 'masked', '.']} />
			<p class="lede">
				Autoregressive models write left to right, one token per forward pass. Diffusion language models start from a
				sequence of blanks and fill them in, several at a time, in whatever order they are most sure of. These notes
				follow two tracks: how the models work, and how to serve them.
			</p>
			<div class="hero-actions">
				{
					first && (
						<a class="btn primary" href={href(first.slug)}>
							Start reading →
						</a>
					)
				}
				<div class="progress" aria-label={`${published.length} of ${series.length} notes published`}>
					{
						tracks.map((t) => (
							<span class="progress-track" aria-hidden="true">
								<span class="progress-code">{t.code}</span>
								<span class="cells">
									{inTrack(t.id).map((s) => (
										<span class:list={['cell', { on: s.post }]} title={`${s.code} ${s.title}`} />
									))}
								</span>
							</span>
						))
					}
					<span class="progress-label">{published.length} / {series.length} unmasked</span>
				</div>
			</div>
		</section>

		<section class="tracks" aria-label="Roadmap">
			{
				tracks.map((track) => {
					const notes = inTrack(track.id);
					const done = notes.filter((n) => n.post).length;
					return (
						<section class="track" id={track.id}>
							<header class="track-head">
								<span class="track-code" aria-hidden="true">
									{track.code}
								</span>
								<div>
									<p class="kicker">
										Track {track.code} · {done} / {notes.length} published
									</p>
									<h2>{track.title}</h2>
								</div>
							</header>
							<p class="track-blurb">{track.blurb}</p>
							{track.groups.map((group) => (
								<div class="group">
									<h3 class="kicker">{group.title}</h3>
									<ol class="notes">
										{notes
											.filter((n) => n.group === group.title)
											.map((n) => (
												<li class:list={{ planned: !n.post }}>
													{n.post ? (
														<a href={href(n.slug)}>
															<span class="n">{n.code}</span>
															<span class="t">{n.title}</span>
															<span class="h">{n.hook}</span>
															<span class="s">{fmt(n.post.data.pubDate)}</span>
														</a>
													) : (
														<div>
															<span class="n">{n.code}</span>
															<span class="t">{n.title}</span>
															<span class="h">{n.hook}</span>
															<span class="s">
																<span class="pill">planned</span>
															</span>
														</div>
													)}
												</li>
											))}
									</ol>
								</div>
							))}
						</section>
					);
				})
			}
		</section>

		{
			loose.length > 0 && (
				<section class="loose">
					<p class="kicker">Also</p>
					<h2>Other notes</h2>
					<ol class="notes">
						{loose.map((n) => (
							<li>
								<a href={href(n.slug)}>
									<span class="n">··</span>
									<span class="t">{n.title}</span>
									<span class="h">{n.hook}</span>
									<span class="s">{fmt(n.post!.data.pubDate)}</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			)
		}
	</main>
</Base>

<style>
	.home {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.hero {
		padding: 5.5rem 0 4.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.lede {
		margin: 0.4rem 0 0;
		max-width: 40rem;
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.hero-actions {
		margin-top: 0.8rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 2rem;
	}
	.progress {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.1rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
	}
	.progress-track {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}
	.progress-code {
		color: var(--fg);
		font-weight: 600;
	}
	.cells {
		display: inline-flex;
		gap: 3px;
	}
	.cell {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 2px;
		background: repeating-linear-gradient(-45deg, var(--mask) 0 3px, var(--mask-hatch) 3px 4px);
	}
	.cell.on {
		background: var(--accent);
	}

	.tracks {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 3.5rem;
		padding-top: 3rem;
		border-top: 1px solid var(--line);
	}
	.track-head {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.track-code {
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		width: 3.1rem;
		height: 3.1rem;
		border-radius: 10px;
		font-family: var(--mono);
		font-size: 1.4rem;
		font-weight: 600;
		color: var(--accent);
		background: var(--accent-soft);
	}
	.track-head h2 {
		margin: 0.25rem 0 0;
		font-size: 1.75rem;
		line-height: 1.15;
		letter-spacing: -0.015em;
	}
	.track-blurb {
		margin: 1.1rem 0 0;
		font-size: 1.02rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.group {
		margin-top: 2rem;
	}
	.group h3 {
		padding-bottom: 0.5rem;
		margin-bottom: 0.4rem;
		border-bottom: 1px dashed var(--line);
		font-weight: 500;
	}

	.notes {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.notes li > * {
		display: grid;
		grid-template-columns: 2.6rem minmax(0, 1fr) auto;
		grid-template-areas:
			'n t s'
			'. h h';
		column-gap: 0.6rem;
		row-gap: 0.1rem;
		padding: 0.75rem 0.8rem;
		margin: 0 -0.8rem;
		border-radius: 8px;
		text-decoration: none;
		transition: background 150ms;
	}
	.notes a:hover {
		background: var(--surface);
		box-shadow: 0 0 0 1px var(--line);
	}
	.notes a:hover .t {
		color: var(--accent);
	}
	.n {
		grid-area: n;
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--faint);
		padding-top: 0.2rem;
	}
	.notes a .n {
		color: var(--accent);
	}
	.t {
		grid-area: t;
		font-weight: 600;
		font-size: 1.08rem;
		line-height: 1.4;
		transition: color 150ms;
	}
	.h {
		grid-area: h;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.s {
		grid-area: s;
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--muted);
		padding-top: 0.25rem;
		white-space: nowrap;
	}
	.planned .t {
		color: var(--muted);
		font-weight: 500;
	}
	.planned .h {
		color: var(--faint);
	}
	.pill {
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		background: repeating-linear-gradient(-45deg, var(--mask) 0 4px, var(--mask-hatch) 4px 6px);
		color: var(--fg);
	}

	.loose {
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--line);
		max-width: 36rem;
	}
	.loose h2 {
		margin: 0.4rem 0 1rem;
		font-size: 1.5rem;
	}

	@media (max-width: 900px) {
		.hero {
			padding: 3.5rem 0 3rem;
		}
		.lede {
			font-size: 1.1rem;
		}
		.tracks {
			grid-template-columns: 1fr;
			gap: 3.5rem;
			padding-top: 2.5rem;
		}
	}
</style>
