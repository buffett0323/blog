---
import MaskedTitle from '../components/MaskedTitle.astro';
import { pad, withBase } from '../consts';
import Base from '../layouts/Base.astro';
import { getSeries, parts } from '../series';

const { series, loose } = await getSeries();
const published = series.filter((s) => s.post);
const first = published[0] ?? loose[0];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<Base>
	<main class="home">
		<section class="hero">
			<p class="kicker">Learning notes · diffusion language models</p>
			<MaskedTitle tokens={['Diffusion', ' LLMs', ',', ' un', 'masked', '.']} />
			<p class="lede">
				Autoregressive models write left to right, one token per forward pass. Diffusion language models start from a
				sequence of blanks and fill them in, several at a time, in whatever order they are most sure of. These are my
				notes on how that works: the objective, the sampler, the models that scaled it, and what it takes to make them
				fast.
			</p>
			<div class="hero-actions">
				{
					first && (
						<a class="btn primary" href={withBase(`/posts/${first.slug}/`)}>
							Start reading →
						</a>
					)
				}
				<div class="progress" aria-label={`${published.length} of ${series.length} notes published`}>
					<span class="cells" aria-hidden="true">
						{series.map((s) => <span class:list={['cell', { on: s.post }]} title={s.title} />)}
					</span>
					<span class="progress-label">{published.length} / {series.length} unmasked</span>
				</div>
			</div>
		</section>

		<section class="roadmap" aria-label="Roadmap">
			{
				parts.map((part, pi) => {
					const notes = series.filter((s) => s.part?.id === part.id);
					return (
						<section class="part">
							<header class="part-head">
								<p class="kicker">Part {roman[pi]}</p>
								<h2>{part.title}</h2>
								<p>{part.blurb}</p>
							</header>
							<ol class="notes">
								{notes.map((n) => (
									<li class:list={{ planned: !n.post }}>
										{n.post ? (
											<a href={withBase(`/posts/${n.slug}/`)}>
												<span class="n">{pad(n.number!)}</span>
												<span class="t">{n.title}</span>
												<span class="h">{n.hook}</span>
												<span class="s">{fmt(n.post.data.pubDate)}</span>
											</a>
										) : (
											<div>
												<span class="n">{pad(n.number!)}</span>
												<span class="t">{n.title}</span>
												<span class="h">{n.hook}</span>
												<span class="s">
													<span class="pill">planned</span>
												</span>
											</div>
										)}
									</li>
								))}
							</ol>
						</section>
					);
				})
			}
			{
				loose.length > 0 && (
					<section class="part">
						<header class="part-head">
							<p class="kicker">Also</p>
							<h2>Other notes</h2>
							<p>Paper notes and one-offs outside the main sequence.</p>
						</header>
						<ol class="notes">
							{loose.map((n) => (
								<li>
									<a href={withBase(`/posts/${n.slug}/`)}>
										<span class="n">··</span>
										<span class="t">{n.title}</span>
										<span class="h">{n.hook}</span>
										<span class="s">{fmt(n.post!.data.pubDate)}</span>
									</a>
								</li>
							))}
						</ol>
					</section>
				)
			}
		</section>
	</main>
</Base>

<style>
	.home {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.hero {
		padding: 5.5rem 0 4.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.lede {
		margin: 0.4rem 0 0;
		max-width: 40rem;
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.hero-actions {
		margin-top: 0.8rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 2rem;
	}
	.progress {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
	}
	.cells {
		display: inline-flex;
		gap: 3px;
	}
	.cell {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 2px;
		background: repeating-linear-gradient(-45deg, var(--mask) 0 3px, var(--mask-hatch) 3px 4px);
	}
	.cell.on {
		background: var(--accent);
	}

	.part {
		display: grid;
		grid-template-columns: 17rem minmax(0, 1fr);
		gap: 2.5rem;
		padding: 2.75rem 0;
		border-top: 1px solid var(--line);
	}
	.part-head h2 {
		margin: 0.5rem 0 0;
		font-size: 1.5rem;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}
	.part-head p:last-child {
		margin: 0.6rem 0 0;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.notes {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.notes li > * {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto;
		grid-template-areas:
			'n t s'
			'. h h';
		column-gap: 0.75rem;
		row-gap: 0.1rem;
		padding: 0.85rem 0.9rem;
		margin: 0 -0.9rem;
		border-radius: 8px;
		text-decoration: none;
		transition: background 150ms;
	}
	.notes a:hover {
		background: var(--surface);
		box-shadow: 0 0 0 1px var(--line);
	}
	.notes a:hover .t {
		color: var(--accent);
	}
	.n {
		grid-area: n;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--faint);
		padding-top: 0.2rem;
	}
	.t {
		grid-area: t;
		font-weight: 600;
		font-size: 1.1rem;
		line-height: 1.4;
		transition: color 150ms;
	}
	.h {
		grid-area: h;
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.s {
		grid-area: s;
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--muted);
		padding-top: 0.25rem;
		white-space: nowrap;
	}
	.planned .t {
		color: var(--muted);
		font-weight: 500;
	}
	.planned .h {
		color: var(--faint);
	}
	.pill {
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		background: repeating-linear-gradient(-45deg, var(--mask) 0 4px, var(--mask-hatch) 4px 6px);
		color: var(--fg);
	}

	@media (max-width: 820px) {
		.hero {
			padding: 3.5rem 0 3rem;
		}
		.lede {
			font-size: 1.1rem;
		}
		.part {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding: 2.25rem 0;
		}
		.notes li > * {
			grid-template-columns: 2rem minmax(0, 1fr) auto;
		}
	}
</style>
