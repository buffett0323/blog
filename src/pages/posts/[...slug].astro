---
import { type CollectionEntry, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getSeries, publishedPosts, readingMinutes } from '../../series';

export async function getStaticPaths() {
	const posts = await publishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content, headings } = await render(post);

// Prev/next stay within the note's track: previous published note, and the next note whether or not it is out yet.
const { series } = await getSeries();
const note = series.find((s) => s.slug === post.id);
const track = note ? series.filter((s) => s.track === note.track) : [];
const i = note ? track.indexOf(note) : -1;
const prev = i > 0 ? track.slice(0, i).findLast((s) => s.post) : undefined;
const next = i >= 0 ? track[i + 1] : undefined;
---

<Post
	{...post.data}
	minutes={readingMinutes(post.body)}
	headings={headings}
	note={note}
	prev={prev}
	next={next}
>
	<Content />
</Post>
