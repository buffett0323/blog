---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../consts';

type Props = HTMLAttributes<'a'> & { href: string };

// `href` is relative to the site base, e.g. '/about'
const { href, class: className, ...props } = Astro.props;
const pathname = '/' + Astro.url.pathname.slice(withBase('/').length).replace(/\/$/, '');
const isActive = href === '/' ? pathname === '/' || pathname.startsWith('/posts') : pathname === href;
---

<a href={withBase(href)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
