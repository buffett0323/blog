---
// TEAM's speculative exploration on one 6-token block, step by step.
// Step t: a normal pass. The two most confident masks that missed the threshold become guesses.
// Step t+1: four copies of the block (no guess / guess 1 / guess 2 / both) run as one batch.
// A guess is verified when branch 0, which guessed nothing, accepts the same token there on its own.
// TEAM continues from the branch with the most verified guesses. Rule taken from the authors' code.
// Probabilities and expert counts are illustrative.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;

type Pred = Record<number, [string, number]>;
interface Scenario {
	label: string;
	guess: [string, string];
	/** Predictions of each branch at step t+1, by position. */
	branches: [Pred, Pred, Pred, Pred];
	/** Passes from step t until the block is finished. */
	passes: { spec: number; normal: number };
}
const TAU = 0.95;
const start = ['So', 'the', null, null, null, null];
// Step t predictions; positions 3 and 4 are the guesses (scenario decides the token).
const stepT: Pred = { 2: ['total', 0.97], 5: ['.', 0.4] };
const A = 3;
const B = 4;
const scenarios: Record<string, Scenario> = {
	right: {
		label: 'Both guesses right',
		guess: ['is', '42'],
		branches: [
			{ 3: ['is', 0.98], 4: ['42', 0.96], 5: ['.', 0.7] },
			{ 4: ['42', 0.97], 5: ['.', 0.85] },
			{ 3: ['is', 0.99], 5: ['.', 0.9] },
			{ 5: ['.', 0.98] },
		],
		passes: { spec: 2, normal: 3 },
	},
	one: {
		label: 'One right',
		guess: ['is', '40'],
		branches: [
			{ 3: ['is', 0.98], 4: ['42', 0.9], 5: ['.', 0.55] },
			{ 4: ['42', 0.97], 5: ['.', 0.8] },
			{ 3: ['is', 0.97], 5: ['.', 0.3] },
			{ 5: ['.', 0.35] },
		],
		passes: { spec: 3, normal: 4 },
	},
	wrong: {
		label: 'Both wrong',
		guess: ['was', '40'],
		branches: [
			{ 3: ['is', 0.98], 4: ['42', 0.9], 5: ['.', 0.55] },
			{ 4: ['42', 0.6], 5: ['.', 0.4] },
			{ 3: ['is', 0.97], 5: ['.', 0.3] },
			{ 5: ['.', 0.2] },
		],
		passes: { spec: 4, normal: 4 },
	},
};
// Experts loaded per layer per pass (of 128): branches route almost alike, so 4 cost little more than 1.
const experts = { one: 34, four: 37 };
---

<figure
	class="spec-demo"
	data-spec-demo
	data-config={JSON.stringify({ TAU, start, stepT, A, B, scenarios, experts })}
>
	<div class="sp-controls">
		<div class="sp-tabs" role="radiogroup" aria-label="Scenario">
			{
				Object.entries(scenarios).map(([k, s], i) => (
					<button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-scn={k}>
						{s.label}
					</button>
				))
			}
		</div>
		<div class="sp-buttons">
			<button class="btn icon" type="button" data-act="prev" aria-label="Previous stage">←</button>
			<button class="btn primary" type="button" data-act="next">Next</button>
		</div>
	</div>

	<ol class="sp-stages" aria-hidden="true">
		<li data-stage="0">Step t: normal pass</li>
		<li data-stage="1">Build 4 branches</li>
		<li data-stage="2">Step t+1: one batched pass</li>
		<li data-stage="3">Verify and pick</li>
	</ol>

	<div class="sp-board" data-board></div>
	<p class="sp-note" data-note></p>
	<div class="sp-result" data-result></div>

	<p class="sp-legend" aria-hidden="true">
		<span><i class="sw acc"></i>accepted (confidence &gt; {TAU})</span>
		<span><i class="sw guess"></i>guessed, filled in as input</span>
		<span><i class="sw mask"></i>[MASK]</span>
	</p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type Pred = Record<number, [string, number]>;
	interface Scenario {
		label: string;
		guess: [string, string];
		branches: Pred[];
		passes: { spec: number; normal: number };
	}
	interface Config {
		TAU: number;
		start: (string | null)[];
		stepT: Pred;
		A: number;
		B: number;
		scenarios: Record<string, Scenario>;
		experts: { one: number; four: number };
	}

	document.querySelectorAll<HTMLElement>('[data-spec-demo]').forEach((fig) => {
		const C: Config = JSON.parse(fig.dataset.config!);
		const board = fig.querySelector<HTMLElement>('[data-board]')!;
		const note = fig.querySelector<HTMLElement>('[data-note]')!;
		const result = fig.querySelector<HTMLElement>('[data-result]')!;
		let scn = 'right';
		let stage = 0;

		const pct = (p: number) => p.toFixed(2).replace(/^0/, '');
		const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

		// One cell: what goes in (token, [MASK] or a guess), and optionally what comes out.
		function cell(input: string | null, opts: { guess?: boolean; out?: [string, number]; verdict?: boolean | null }) {
			const { guess, out, verdict } = opts;
			const accepted = !!out && out[1] > C.TAU;
			const cls = ['sp-cell', input === null ? 'mask' : guess ? 'guess' : 'tok', accepted ? 'acc' : ''].join(' ');
			const shown = accepted ? out![0] : input ?? '';
			const sub = out ? `<span class="sp-out">${esc(out[0])} ${pct(out[1])}</span>` : '<span class="sp-out"></span>';
			const badge = verdict === undefined || verdict === null ? '' : `<span class="sp-badge ${verdict ? 'ok' : 'bad'}">${verdict ? '✓' : '✗'}</span>`;
			return `<div class="${cls}"><span class="sp-in">${esc(shown)}</span>${sub}${badge}</div>`;
		}

		function row(label: string, cells: string, cls = '') {
			return `<div class="sp-row ${cls}"><span class="sp-label">${label}</span><div class="sp-cells">${cells}</div></div>`;
		}

		function render() {
			const s = C.scenarios[scn];
			// State after step t: position 2 accepted.
			const afterT = C.start.map((t, i) => (i in C.stepT && C.stepT[i][1] > C.TAU ? C.stepT[i][0] : t));
			const guessPred: Pred = { ...C.stepT, [C.A]: [s.guess[0], 0.88], [C.B]: [s.guess[1], 0.62] };
			const inputs = [
				afterT,
				afterT.map((t, i) => (i === C.A ? s.guess[0] : t)),
				afterT.map((t, i) => (i === C.B ? s.guess[1] : t)),
				afterT.map((t, i) => (i === C.A ? s.guess[0] : i === C.B ? s.guess[1] : t)),
			];
			const isGuess = (b: number, i: number) => (i === C.A && (b === 1 || b === 3)) || (i === C.B && (b === 2 || b === 3));
			const b0 = s.branches[0];
			const okA = !!b0[C.A] && b0[C.A][1] > C.TAU && b0[C.A][0] === s.guess[0];
			const okB = !!b0[C.B] && b0[C.B][1] > C.TAU && b0[C.B][0] === s.guess[1];
			const choice = okA && okB ? 3 : okA ? 1 : okB ? 2 : 0;
			const names = ['0 · no guess', `1 · +“${s.guess[0]}”`, `2 · +“${s.guess[1]}”`, '3 · + both'];

			if (stage === 0) {
				board.innerHTML = row(
					'step t',
					C.start.map((t, i) => cell(t, { out: guessPred[i] })).join(''),
				);
				note.innerHTML = `“total” clears ${C.TAU} and is accepted. “${esc(s.guess[0])}” (.88) and “${esc(s.guess[1])}” (.62) are the two most confident tokens that did <b>not</b> clear it: they become the guesses.`;
			} else {
				const rows = inputs.map((inp, b) => {
					const pred = stage >= 2 ? s.branches[b] : {};
					const cells = inp
						.map((t, i) =>
							cell(t, {
								guess: isGuess(b, i),
								out: pred[i],
								verdict: stage === 3 && b === 0 && (i === C.A || i === C.B) ? (i === C.A ? okA : okB) : null,
							}),
						)
						.join('');
					return row(`branch ${names[b]}`, cells, stage === 3 ? (b === choice ? 'chosen' : 'dropped') : '');
				});
				board.innerHTML = rows.join('');
				note.innerHTML =
					stage === 1
						? 'Four copies of the block. Guessed tokens are written in as if they had been accepted, so the other positions can use them as context.'
						: stage === 2
							? 'All four run as one batch: 4 × 6 = 24 token positions instead of 6. Each branch predicts its remaining masks.'
							: `Check branch 0, which guessed nothing: does it accept the guessed positions with the guessed tokens? “${esc(s.guess[0])}”: ${okA ? 'yes ✓' : 'no ✗'}. “${esc(s.guess[1])}”: ${okB ? 'yes ✓' : 'no ✗'}. Continue from <b>branch ${choice}</b>${choice === 0 ? ', the normal path: nothing gained, nothing broken.' : ', whose predictions were already made with the verified guesses as context.'}`;
			}

			if (stage === 3) {
				const chosen = s.branches[choice];
				const accOf = (p: Pred) => Object.values(p).filter(([, c]) => c > C.TAU).length;
				const accSpec = accOf(chosen) + (choice === 1 || choice === 3 ? 1 : 0) + (choice === 2 || choice === 3 ? 1 : 0);
				const accNormal = accOf(b0);
				const cost = C.experts.four / C.experts.one;
				const tSpec = s.passes.spec * cost;
				const ratio = s.passes.normal / tSpec;
				result.innerHTML = `
					<div><span class="sp-k">tokens accepted this pass</span><span class="sp-v">${accSpec} <small>vs ${accNormal} without guessing</small></span></div>
					<div><span class="sp-k">passes to finish the block, from step t</span><span class="sp-v">${s.passes.spec} <small>vs ${s.passes.normal}</small></span></div>
					<div><span class="sp-k">cost of one pass with 4 branches</span><span class="sp-v">×4 <small>token positions</small> · ${C.experts.one} → ${C.experts.four} <small>experts loaded</small></span></div>
					<div><span class="sp-k">net time, if memory-bound</span><span class="sp-v">${ratio >= 1 ? `${ratio.toFixed(2)}× faster` : `${(1 / ratio).toFixed(2)}× slower`}</span></div>`;
				result.hidden = false;
			} else {
				result.hidden = true;
			}

			fig.querySelectorAll<HTMLElement>('.sp-stages li').forEach((li) => li.classList.toggle('on', Number(li.dataset.stage) === stage));
			fig.querySelector<HTMLButtonElement>('[data-act="prev"]')!.disabled = stage === 0;
			fig.querySelector<HTMLButtonElement>('[data-act="next"]')!.disabled = stage === 3;
		}

		fig.querySelectorAll<HTMLButtonElement>('[data-scn]').forEach((b) =>
			b.addEventListener('click', () => {
				scn = b.dataset.scn!;
				fig.querySelectorAll('[data-scn]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
				render();
			}),
		);
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => ((stage = Math.min(3, stage + 1)), render()));
		fig.querySelector('[data-act="prev"]')!.addEventListener('click', () => ((stage = Math.max(0, stage - 1)), render()));
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.spec-demo {
		--c-acc: #2f6fb3;
		--c-guess: #c2410c;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .spec-demo {
		--c-acc: #4f8fd6;
		--c-guess: #e06a2c;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .spec-demo {
			--c-acc: #4f8fd6;
			--c-guess: #e06a2c;
		}
	}
	.spec-demo:not(.ready) {
		display: none;
	}
	.sp-controls {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}
	.sp-tabs {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 3px;
		gap: 2px;
		border-radius: 8px;
		background: var(--code-bg);
	}
	.sp-tabs button {
		padding: 0.35rem 0.7rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--muted);
		font: 0.78rem var(--mono);
		cursor: pointer;
	}
	.sp-tabs button[aria-checked='true'] {
		background: var(--surface);
		color: var(--fg);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
	}
	.sp-buttons {
		display: flex;
		gap: 0.4rem;
	}
	.sp-stages {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 4px;
		margin: 1rem 0 0;
		padding: 0 0 1rem;
		list-style: none;
		border-bottom: 1px dashed var(--line);
		counter-reset: st;
	}
	.sp-stages li {
		counter-increment: st;
		padding: 0.35rem 0.5rem;
		border-radius: 6px;
		font-family: var(--mono);
		font-size: 0.7rem;
		line-height: 1.3;
		color: var(--faint);
		border-top: 3px solid var(--line);
	}
	.sp-stages li::before {
		content: counter(st) '. ';
	}
	.sp-stages li.on {
		color: var(--fg);
		border-top-color: var(--accent);
	}
	.sp-board {
		display: grid;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.sp-board :global(.sp-row) {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		align-items: center;
		gap: 0.6rem;
		padding: 0.35rem;
		border-radius: 8px;
		transition: opacity 200ms;
	}
	.sp-board :global(.sp-row.chosen) {
		box-shadow: 0 0 0 1.5px var(--accent);
		background: var(--accent-soft);
	}
	.sp-board :global(.sp-row.dropped) {
		opacity: 0.4;
	}
	.sp-board :global(.sp-label) {
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.sp-board :global(.sp-cells) {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 4px;
	}
	.sp-board :global(.sp-cell) {
		position: relative;
		display: grid;
		gap: 0.2rem;
		padding: 0.4rem 0.2rem 0.3rem;
		border-radius: 5px;
		background: var(--code-bg);
		text-align: center;
		font-family: var(--mono);
	}
	.sp-board :global(.sp-in) {
		min-height: 1.1em;
		font-size: 0.82rem;
	}
	.sp-board :global(.sp-out) {
		min-height: 1em;
		font-size: 0.66rem;
		color: var(--muted);
	}
	.sp-board :global(.sp-cell.mask) {
		background: repeating-linear-gradient(-45deg, var(--mask) 0 4px, var(--mask-hatch) 4px 6px);
	}
	.sp-board :global(.sp-cell.guess) {
		background: var(--surface);
		box-shadow: inset 0 0 0 1.5px var(--c-guess);
		outline: 1.5px dashed var(--c-guess);
		outline-offset: -1.5px;
	}
	.sp-board :global(.sp-cell.acc) {
		background: color-mix(in srgb, var(--c-acc) 22%, var(--surface));
		box-shadow: inset 0 0 0 1.5px var(--c-acc);
		outline: none;
	}
	.sp-board :global(.sp-badge) {
		position: absolute;
		top: -0.55rem;
		right: -0.35rem;
		width: 1.15rem;
		height: 1.15rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		font-size: 0.7rem;
		color: #fff;
	}
	.sp-board :global(.sp-badge.ok) {
		background: var(--c-acc);
	}
	.sp-board :global(.sp-badge.bad) {
		background: var(--c-guess);
	}
	.sp-note {
		margin: 0.8rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.sp-note :global(b) {
		color: var(--fg);
	}
	.sp-result {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem 1.25rem;
		margin-top: 0.8rem;
		padding-top: 0.8rem;
		border-top: 1px dashed var(--line);
	}
	.sp-result[hidden] {
		display: none;
	}
	.sp-result :global(div) {
		display: grid;
		gap: 0.1rem;
	}
	.sp-result :global(.sp-k) {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.sp-result :global(.sp-v) {
		font-family: var(--mono);
		font-size: 1rem;
		font-weight: 600;
	}
	.sp-result :global(small) {
		font-weight: 400;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.sp-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 1rem 0 0;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.sp-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
	}
	.sw.acc {
		background: color-mix(in srgb, var(--c-acc) 22%, var(--surface));
		box-shadow: inset 0 0 0 1.5px var(--c-acc);
	}
	.sw.guess {
		outline: 1.5px dashed var(--c-guess);
		outline-offset: -1.5px;
	}
	.sw.mask {
		background: repeating-linear-gradient(-45deg, var(--mask) 0 3px, var(--mask-hatch) 3px 4px);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.spec-demo {
			padding: 1rem;
		}
		.sp-board :global(.sp-row) {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
		.sp-result {
			grid-template-columns: 1fr;
		}
		.sp-stages li {
			font-size: 0.62rem;
		}
	}
</style>
