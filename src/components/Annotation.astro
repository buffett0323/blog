---
// A note pinned to a piece of text in the paper's PDF. Use it in src/content/papers/*.mdx:
//
//   <Annotation page={5} line={41} text="Confidence-Aware Parallel Decoding">
//   Markdown (and $math$) goes here.
//   </Annotation>
//
// `page` is 1-based. `line` counts visual lines from the top of the page, 1-based, including running
// headers and text inside figures; open the paper with ?lines in the URL to see the numbers. If `line`
// is left out, the `occurrence`-th match of `text` on the page is used (default: the first).
// Matching ignores whitespace, so "KV Cache" also matches text split across several PDF runs.
interface Props {
	page: number;
	text: string;
	line?: number;
	occurrence?: number;
	color?: 'yellow' | 'green' | 'blue' | 'pink';
}
const { page, text, line, occurrence, color = 'yellow' } = Astro.props;
---

<aside class="anno" data-color={color} data-page={page} data-text={text} data-line={line} data-occurrence={occurrence}>
	<p class="anno-quote">
		<span class="anno-num"></span>
		<span class="anno-loc">p.{page}{line && ` · line ${line}`}</span>
		<q>{text}</q>
	</p>
	<div class="anno-body"><slot /></div>
</aside>

<style is:global>
	/* Notes. Before the viewer moves them into place (or without JS) they are a plain list. */
	.anno {
		margin: 1rem 0;
		padding: 0.8rem 1rem;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		border-left: 3px solid var(--anno-c, #e0b400);
		background: var(--surface);
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.anno[data-color='green'] {
		--anno-c: #34a853;
	}
	.anno[data-color='blue'] {
		--anno-c: #3b82f6;
	}
	.anno[data-color='pink'] {
		--anno-c: #e11d74;
	}
	.anno.active {
		border-color: var(--accent);
		border-left-color: var(--anno-c, #e0b400);
	}
	.anno.unanchored {
		border-style: dashed;
	}
	.anno-quote {
		margin: 0 0 0.4rem;
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
		cursor: pointer;
	}
	.anno-num {
		flex: 0 0 auto;
		min-width: 1.4em;
		padding: 0 0.3em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		text-align: center;
	}
	.anno-num:empty {
		display: none;
	}
	.anno-loc {
		flex: 0 0 auto;
	}
	.anno-quote q {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.anno-body > * {
		margin: 0;
	}
	.anno-body > * + * {
		margin-top: 0.6em;
	}
	.anno-body code {
		font-size: 0.85em;
	}

	/* Hidden in the summary until the PDF viewer moves them next to their page. */
	.js .paper-summary:not(.no-pdf) .anno {
		display: none;
	}
</style>
