---
// Which cached keys/values survive a decoding step. Each cell is one token's K/V at one layer.
// AR: a new column is appended; causal attention means old columns never change.
// dLLM (exact): one position is unmasked; its layer-1 K/V changes, and from layer 2 up every
//   position attends to it, so every cell is stale.
// dLLM (approximate): same staleness, but prompt cells are reused anyway (the prefix-cache bet).
interface Props {
	prompt?: string[];
	answer?: string[];
	/** Order in which the dLLM unmasks answer positions (0-based within the answer). */
	order?: number[];
	layers?: number;
	caption?: string;
}
const {
	prompt = ['What', 'is', 'the', 'capital', '?'],
	answer = ['Paris', 'is', 'the', 'capital', '.'],
	order = [0, 4, 3, 1, 2],
	layers = 4,
	caption,
} = Astro.props;
const n = prompt.length + answer.length;
---

<figure
	class="cache-demo"
	data-cache-demo
	data-prompt={JSON.stringify(prompt)}
	data-answer={JSON.stringify(answer)}
	data-order={JSON.stringify(order)}
	data-layers={layers}
>
	<div class="cd-controls">
		<div class="cd-modes" role="radiogroup" aria-label="Model">
			<button type="button" role="radio" aria-checked="true" data-mode="ar">AR</button>
			<button type="button" role="radio" aria-checked="false" data-mode="exact">dLLM, exact</button>
			<button type="button" role="radio" aria-checked="false" data-mode="approx">dLLM, prompt cached</button>
		</div>
		<div class="cd-buttons">
			<button class="btn icon" type="button" data-act="reset" aria-label="Reset">↺</button>
			<button class="btn primary" type="button" data-act="next">Next step</button>
		</div>
	</div>

	<div class="cd-board" style={`--cols:${n}`}>
		{
			Array.from({ length: layers }, (_, k) => layers - k).map((l) => (
				<>
					<span class="cd-axis">layer {l}</span>
					{Array.from({ length: n }, (_, i) => (
						<span class="cd-cell" data-l={l} data-i={i} />
					))}
				</>
			))
		}
		<span class="cd-axis">token</span>
		{Array.from({ length: n }, (_, i) => <span class="cd-tok" data-i={i} />)}
	</div>

	<p class="cd-legend" aria-hidden="true">
		<span><i class="sw computed"></i>computed this step</span>
		<span><i class="sw cached"></i>reused, still exact</span>
		<span><i class="sw stale"></i>reused, slightly stale</span>
	</p>
	<p class="cd-note" data-note></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type State = 'computed' | 'cached' | 'stale' | 'none';

	document.querySelectorAll<HTMLElement>('[data-cache-demo]').forEach((fig) => {
		const prompt: string[] = JSON.parse(fig.dataset.prompt!);
		const answer: string[] = JSON.parse(fig.dataset.answer!);
		const order: number[] = JSON.parse(fig.dataset.order!);
		const L = Number(fig.dataset.layers);
		const P = prompt.length;
		const n = P + answer.length;
		const cells = [...fig.querySelectorAll<HTMLElement>('.cd-cell')];
		const toks = [...fig.querySelectorAll<HTMLElement>('.cd-tok')];
		const note = fig.querySelector<HTMLElement>('[data-note]')!;

		let mode: 'ar' | 'exact' | 'approx' = 'ar';
		// Step 0 is the prefill / first full pass; each later step reveals one answer token.
		let step = 0;
		let timers: ReturnType<typeof setTimeout>[] = [];

		const revealed = (s: number) => new Set(order.slice(0, s).map((a) => P + a));

		function grid(): { state: State[][]; label: string } {
			const state: State[][] = Array.from({ length: L + 1 }, () => Array<State>(n).fill('none'));
			if (mode === 'ar') {
				// Columns that exist: prompt plus the answer tokens fed back so far.
				const len = P + step;
				for (let i = 0; i < len; i++) for (let l = 1; l <= L; l++) state[l][i] = step === 0 || i === len - 1 ? 'computed' : 'cached';
				const computed = step === 0 ? P * L : L;
				return { state, label: step === 0 ? `Prefill: all ${P} prompt tokens, ${computed} cells. They will never change.` : `Only the new token's column: ${computed} cells. Causal attention means no old column can see it.` };
			}
			const changed = step === 0 ? null : P + order[step - 1];
			let computed = 0;
			for (let l = 1; l <= L; l++)
				for (let i = 0; i < n; i++) {
					let s: State;
					if (changed === null) s = 'computed';
					// Layer 1 depends only on the token itself.
					else if (l === 1) s = i === changed ? 'computed' : 'cached';
					else if (mode === 'approx' && i < P) s = 'stale';
					else s = 'computed';
					if (s === 'computed') computed++;
					state[l][i] = s;
				}
			const label =
				step === 0
					? `First pass: every cell, ${computed} in all.`
					: mode === 'exact'
						? `Position ${changed! + 1} changed. Layer 1: only its column. Layer 2 up: everyone attends to it, so all ${computed} cells must be recomputed.`
						: `Same change, but the prompt's layers 2–${L} are reused even though they are slightly off. ${computed} cells computed instead of ${1 + (L - 1) * n}.`;
			return { state, label };
		}

		function render(animate: boolean) {
			timers.forEach(clearTimeout);
			timers = [];
			const { state, label } = grid();
			const shown = mode === 'ar' ? P + step : n;
			const rev = revealed(step);
			toks.forEach((el, i) => {
				const isPrompt = i < P;
				const text = isPrompt ? prompt[i] : answer[i - P];
				const visible = mode === 'ar' ? i < shown : true;
				const masked = mode !== 'ar' && !isPrompt && !rev.has(i);
				el.textContent = masked ? '' : text;
				el.classList.toggle('masked', masked);
				el.classList.toggle('absent', !visible);
				el.classList.toggle('prompt', isPrompt);
				el.classList.toggle('fresh', step > 0 && (mode === 'ar' ? i === shown - 1 : i === P + order[step - 1]));
			});
			// Reveal layer by layer so the dependency spreading upward is visible.
			for (let l = 1; l <= L; l++) {
				const apply = () =>
					cells
						.filter((c) => Number(c.dataset.l) === l)
						.forEach((c) => {
							const s = state[l][Number(c.dataset.i)];
							c.className = `cd-cell ${s}`;
						});
				if (animate) {
					cells.filter((c) => Number(c.dataset.l) === l).forEach((c) => (c.className = 'cd-cell pending'));
					timers.push(setTimeout(apply, 160 * l));
				} else apply();
			}
			note.textContent = label;
			const max = mode === 'ar' ? answer.length : order.length;
			fig.querySelector<HTMLButtonElement>('[data-act="next"]')!.disabled = step >= max;
			fig.querySelector<HTMLButtonElement>('[data-act="reset"]')!.disabled = step === 0;
		}

		fig.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) =>
			btn.addEventListener('click', () => {
				mode = btn.dataset.mode as typeof mode;
				fig.querySelectorAll('[data-mode]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
				step = Math.min(step, 1);
				render(false);
			}),
		);
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => {
			step++;
			render(true);
		});
		fig.querySelector('[data-act="reset"]')!.addEventListener('click', () => {
			step = 0;
			render(false);
		});

		fig.classList.add('ready');
		render(false);
	});
</script>

<style>
	.cache-demo {
		--c-computed: #c2410c;
		--c-cached: #2f6fb3;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .cache-demo {
		--c-computed: #e06a2c;
		--c-cached: #4f8fd6;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .cache-demo {
			--c-computed: #e06a2c;
			--c-cached: #4f8fd6;
		}
	}
	.cache-demo:not(.ready) {
		display: none;
	}
	.cd-controls {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding-bottom: 1rem;
		border-bottom: 1px dashed var(--line);
	}
	.cd-modes {
		display: inline-flex;
		padding: 3px;
		gap: 2px;
		border-radius: 8px;
		background: var(--code-bg);
	}
	.cd-modes button {
		padding: 0.35rem 0.7rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--muted);
		font: 0.78rem var(--mono);
		cursor: pointer;
	}
	.cd-modes button[aria-checked='true'] {
		background: var(--surface);
		color: var(--fg);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
	}
	.cd-buttons {
		display: flex;
		gap: 0.4rem;
	}
	.cd-board {
		display: grid;
		grid-template-columns: 4.2rem repeat(var(--cols), minmax(0, 1fr));
		gap: 3px;
		margin-top: 1.1rem;
		align-items: center;
	}
	.cd-axis {
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--muted);
	}
	.cd-cell {
		height: 1.6rem;
		border-radius: 3px;
		background: transparent;
		transition:
			background 200ms,
			box-shadow 200ms;
	}
	.cd-cell.computed {
		background: var(--c-computed);
	}
	.cd-cell.cached {
		background: color-mix(in srgb, var(--c-cached) 30%, var(--surface));
	}
	.cd-cell.stale {
		background: repeating-linear-gradient(
			-45deg,
			color-mix(in srgb, var(--c-cached) 30%, var(--surface)) 0 4px,
			color-mix(in srgb, var(--c-computed) 35%, var(--surface)) 4px 6px
		);
	}
	.cd-cell.pending {
		background: var(--code-bg);
	}
	.cd-tok {
		min-height: 1.7rem;
		display: grid;
		place-items: center;
		font-family: var(--mono);
		font-size: 0.72rem;
		border-radius: 4px;
		background: var(--code-bg);
		overflow: hidden;
		text-overflow: ellipsis;
		transition: opacity 200ms;
	}
	.cd-tok.prompt {
		background: color-mix(in srgb, var(--fg) 9%, var(--surface));
	}
	.cd-tok.masked {
		background: repeating-linear-gradient(-45deg, var(--mask) 0 4px, var(--mask-hatch) 4px 6px);
	}
	.cd-tok.absent {
		opacity: 0;
	}
	.cd-tok.fresh {
		box-shadow: inset 0 0 0 1.5px var(--c-computed);
	}
	.cd-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.2rem;
		margin: 0.9rem 0 0;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.cd-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
	}
	.sw.computed {
		background: var(--c-computed);
	}
	.sw.cached {
		background: color-mix(in srgb, var(--c-cached) 30%, var(--surface));
	}
	.sw.stale {
		background: repeating-linear-gradient(
			-45deg,
			color-mix(in srgb, var(--c-cached) 30%, var(--surface)) 0 3px,
			color-mix(in srgb, var(--c-computed) 35%, var(--surface)) 3px 4px
		);
	}
	.cd-note {
		margin: 0.6rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.cache-demo {
			padding: 1rem;
		}
		.cd-board {
			grid-template-columns: 3.2rem repeat(var(--cols), minmax(0, 1fr));
		}
		.cd-tok {
			font-size: 0.6rem;
		}
	}
</style>
